PORT=3001
SEARCHKIT_INDEX=private_posts
ELASTICSEARCH_URL=http://localhost:9200
# Optional auth:
# ELASTICSEARCH_USERNAME=elastic
# ELASTICSEARCH_PASSWORD=changeme
# ELASTICSEARCH_API_KEY=base64apikey
# Comma-separated list. Leave empty for all origins.
SEARCH_ALLOWED_ORIGINS=http://localhost:4000

# Async Python job runner configuration for post actions.
PYTHON_EXECUTABLE=python3
ANKI_JOB_MODEL=gpt-4.1-mini
ANKI_JOB_FALLBACK_MODEL=
ANKI_JOB_TIMEOUT_SECONDS=120
ANKI_JOB_RETRIES=2
ANKI_JOB_PROMPT_NAME=anki_cards
LLM_JOB_RETENTION_MS=3600000
